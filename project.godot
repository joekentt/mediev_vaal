; ARQUIVO GERADO — NÃO EDITE À MÃO.
; Gerado por: tools/gen_project.py
; Fonte:      tools/params.py
; Regenerar:  make all

config_version=5

[application]

config/name="Mediev Vaal"
config/description="RPG 3D low poly de fantasia medieval original, 100% gerado por script."
run/main_scene="res://scenes/world/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[audio]

buses/default_bus_layout="res://assets/generated/audio/default_bus_layout.tres"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
TimeSystem="*res://scripts/core/time_system.gd"

[debug]

gdscript/warnings/inferred_declaration=1
gdscript/warnings/untyped_declaration=1

[importer_defaults]

wav={
"compress/mode": 0,
"edit/trim": 0,
"edit/normalize": 0,
"force/mono": 1
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"pressed":false)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"pressed":false)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1)
]
}
move_left={
